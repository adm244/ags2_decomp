# static library building for msvc

LIB_NAME = $(LIB_DIR)/jgmod.lib

OBJ_LIST = \
$(OBJ_DIR)/file_io.obj \
$(OBJ_DIR)/load_mod.obj \
$(OBJ_DIR)/load_s3m.obj \
$(OBJ_DIR)/load_xm.obj \
$(OBJ_DIR)/load_it.obj \
$(OBJ_DIR)/load_jgm.obj \
$(OBJ_DIR)/save_jgm.obj \
$(OBJ_DIR)/mod.obj \
$(OBJ_DIR)/player.obj \
$(OBJ_DIR)/player2.obj \
$(OBJ_DIR)/player3.obj \
$(OBJ_DIR)/player4.obj \

CFLAGS = /nologo /GB /Ox /MT /W3 /Gd
CFLAGS += /Isrc /I../all3927/include

$(OBJ_DIR)/%.obj: $(SRC_DIR)/%.c
	$(CC) /c $(CFLAGS) /Fo$@ $<

$(LIB_NAME): $(OBJ_LIST)
	$(VCLIB) /nologo /out:$(LIB_NAME) $(OBJ_LIST)
